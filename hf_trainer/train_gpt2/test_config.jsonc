{
  // Model configuration
  "model": {
    "hf_model_path": "gpt2",  // Small GPT2 model
    "use_bf16": false,  // Disable BF16 for GPT2 training
    
    // Model-specific arguments
    "model_args": {
      "trust_remote_code": true
    }
  },

  // Training configuration
  "training": {
    "gradient_accumulation_steps": 2,
    "training_steps": 20,  // Limited steps for testing
    "save_steps": 10,
    "save_total_limit": 1,
    "logging_steps": 5,
    "microbatch_size": 1,
    "output_dir": "./test_output"
  },

  // Optimizer and scheduler configuration
  "optimizer": {
    "name": "adamw",
    "max_learning_rate": 5e-5,  // Learning rate after warmup
    "min_learning_rate": 1e-6,  // Final learning rate after cosine decay
    "warmup_steps": 10,  // Number of warmup steps
    "scheduler": "cosine",  // Options: linear, cosine, constant, constant_with_warmup
    "weight_decay": 0.01,
    "beta1": 0.9,
    "beta2": 0.999,
    "epsilon": 1e-8
  },

  // Dataset configuration (using TextDatasetStreamer)
  "dataset": {
    "packing_batch_size": 2,  // Small batch size for testing
    "packing_context_length": 128,  // Short context length for testing
    "shuffle_buffer_size": 10,
    "seed": 42,
    "datasets": [
      {
        "hf_path": "wikitext",
        "hf_args": {
          "name": "wikitext-2-raw-v1",  // Smaller dataset for testing
          "split": "train"
        },
        "template": "{text}",
        "weight": 1.0
      }
    ]
  },

  // Logging configuration
  "logging": {
    "wandb": {
      "enabled": false
    }
  }
}
