{
  // Model configuration
  "model": {
    "hf_model_path": "gpt2",  // HF model name or local path
    "use_amp_bf16": false,
    "load_in_8bit": false,
    "load_in_4bit": false,
    "force_cpu": false,  // Set to true to force CPU usage even if CUDA is available
    
    // Model-specific arguments passed directly to from_pretrained
    "model_args": {
      "trust_remote_code": true,
      // Add any other model-specific arguments here
    }
  },

  // Training configuration
  "training": {
    "gradient_accumulation_steps": 4,
    "training_steps": 10000,  // Total number of training steps
    "save_steps": 1000,
    "save_total_limit": 3,
    "logging_steps": 100,
    "microbatch_size": 1,  // Number of samples processed at once
    "output_dir": "./output"
  },

  // Optimizer and scheduler configuration
  "optimizer": {
    "name": "adamw",  // Options: adamw, adafactor, sgd, adam
    "max_learning_rate": 5e-5,  // Learning rate after warmup
    "min_learning_rate": 1e-6,  // Final learning rate after cosine decay
    "warmup_steps": 500,  // Number of warmup steps
    "scheduler": "cosine",  // Options: linear, cosine, constant, constant_with_warmup
    "weight_decay": 0.01,
    "beta1": 0.9,
    "beta2": 0.999,
    "epsilon": 1e-8
  },

  // Dataset configuration (using TextDatasetStreamer)
  "dataset": {
    "packing_context_length": 4096,
    "shuffle_buffer_size": 100,
    "seed": 42,
    "datasets": [
      {
        "hf_path": "wikitext",
        "hf_args": {
          "name": "wikitext-103-v1",
          "split": "train"
        },
        "template": "{text}",
        "weight": 1.0
      },
      {
        "hf_path": "Anthropic/hh-rlhf",
        "hf_args": {
          "split": "train"
        },
        "template": "### Human: {human}\n\n### Assistant: {assistant}",
        "weight": 2.0
      }
    ]
  },

  // Logging configuration
  "logging": {
    "wandb": {
      "enabled": false,
      "project": "hf-trainer",
      "name": "training-run-1",
      "entity": null,  // Your W&B username or team name
      "tags": ["gpt2", "finetune"]
    }
  }
}
